<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    tools:context=".MainActivity">

    <!-- FORMAS GEOMÉTRICAS DE FUNDO (Triângulos dinâmicos) -->

    <!-- Triângulo/Ângulo Superior (Verde Oliva Escuro) -->
    <View
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:background="#2D3A0A"
        android:rotation="-35"
        android:translationX="-120dp"
        android:translationY="-150dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Triângulo/Ângulo Inferior Direito (Verde Lima de destaque com leve transparência) -->
    <View
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:background="#1A85A000"
        android:rotation="45"
        android:translationX="70dp"
        android:translationY="190dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Acento geométrico secundário (Cinza Escuro da paleta) -->
    <View
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="#252525"
        android:rotation="15"
        android:translationX="80dp"
        android:translationY="-50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- LOGO CENTRAL -->
    <!-- Caso tenha a logo em imagem depois, basta trocar este TextView por um ImageView -->
    <TextView
        android:id="@+id/tvLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Zenith"
        android:textColor="#FFFFFF"
        android:textSize="64sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45" />

    <!-- Ponto verde ao lado da logo para dar um charme da marca -->
    <View
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="16dp"
        android:background="#85A000"
        app:layout_constraintBottom_toBottomOf="@+id/tvLogo"
        app:layout_constraintStart_toEndOf="@+id/tvLogo" />

    <!-- FRASE MOTIVACIONAL NO RODAPÉ -->
    <TextView
        android:id="@+id/tvQuote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="50dp"
        android:text="Seja sua melhor versão.\nTodo dia."
        android:textAlignment="center"
        android:textColor="#E2E2E2"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Linha de destaque verde sobre a frase motivacional -->
    <View
        android:layout_width="40dp"
        android:layout_height="3dp"
        android:layout_marginBottom="16dp"
        android:background="#85A000"
        app:layout_constraintBottom_toTopOf="@+id/tvQuote"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>