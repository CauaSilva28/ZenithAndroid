<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    tools:context=".CriarTreino">

    <!-- CABEÇALHO -->
    <LinearLayout
        android:id="@+id/headerTreino"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnVoltarTreino"
            android:layout_width="103dp"
            android:layout_height="48dp"
            android:backgroundTint="#1A1A1A"
            android:text="Voltar"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Novo Treino"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/linhaDivisoria"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#252525"
        app:layout_constraintTop_toBottomOf="@+id/headerTreino" />

    <!-- FORMULÁRIO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linhaDivisoria">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- TÍTULO DO TREINO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="NOME DO TREINO"
                android:textColor="#85A000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTituloTreino"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="20dp"
                android:background="#1A1A1A"
                android:hint="Ex: Treino A - Peito e Tríceps"
                android:inputType="textCapSentences"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777" />

            <!-- DATA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="DATA PROGRAMADA"
                android:textColor="#85A000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDataTreino"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="20dp"
                android:background="#1A1A1A"
                android:hint="Ex: 12/04/2026"
                android:inputType="date"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777" />

            <!-- LISTA DE EXERCÍCIOS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="EXERCÍCIOS"
                android:textColor="#85A000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Escreva um exercício por linha"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etExercicios"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginBottom="20dp"
                android:background="#1A1A1A"
                android:gravity="top|start"
                android:hint="Supino Reto 4x10\nSupino Inclinado 3x12\nCrucifixo 3x12"
                android:inputType="textMultiLine"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555" />

            <!-- OBSERVAÇÕES (Opcional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="DESCRIÇÃO / OBSERVAÇÕES (OPCIONAL)"
                android:textColor="#85A000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etObservacoesTreino"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="32dp"
                android:background="#1A1A1A"
                android:gravity="top|start"
                android:hint="Foco em progressão de carga"
                android:inputType="textMultiLine"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777" />

            <!-- BOTÃO SALVAR TREINO -->
            <Button
                android:id="@+id/btnSalvarTreino"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#85A000"
                android:text="SALVAR TREINO"
                android:textColor="#050505"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>