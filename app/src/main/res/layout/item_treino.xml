<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="#1A1A1A"
    android:orientation="vertical"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTituloItemTreino"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Título do Treino"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Marcador visual de Status -->
        <TextView
            android:id="@+id/tvStatusItemTreino"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2D3A0A"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Pendente"
            android:textColor="#85A000"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDataItemTreino"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Data: 12/04/2026"
        android:textColor="#AAAAAA"
        android:textSize="14sp" />

</LinearLayout>